---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const categories = [
  {
    title: 'Aperitief',
    items: ['Worst saté', 'Merguez worst', 'Vleugelboutje', 'Halve sparerib', 'Apéro fakkel', 'Mini kipsaté', 'Scampibrochette', 'Souvlakibrochette'],
  },
  {
    title: 'Rundsvlees',
    items: ['Cote à l\'os (gemarineerd)', 'Gemarineerde steak', 'Entrecote', 'Filet mignon', 'Gemarineerde rundsbrochette', 'Filet pure brochette'],
  },
  {
    title: 'Varkensvlees',
    items: ['Opgevuld varkenshaasje', 'Gemarineerde kotelet', 'Sparerib (gemarineerd)', 'Gemarineerde mignonnette', 'Souvlaki brochette', 'Gemarineerd spek', 'Witte pens', 'Witte pens opgevuld met kaas', 'Luikse pens', 'Tomahawk (Gemarineerd)'],
  },
  {
    title: 'Gevogelte',
    items: ['Gemarineerde kipfilet', 'Merguez worst', 'Gemarineerde kalkoenfilet', 'Gemarineerde gevogelte brochette', 'Gemarineerde kippenvleugels', 'Gemarineerde kippendijen', 'Gemarineerd kippenboutje'],
  },
  {
    title: 'Lamsvlees',
    items: ['Gemarineerde lamskroon', 'Half lamskroontje', 'Gemarineerde lamsfilet', 'Lamskotelet natuur', 'Gemarineerde lamskotelet', 'Lamsboutsneden (gemarineerd)'],
  },
  {
    title: 'Vis',
    items: ['Scampibrochette', 'Zalmfilet in papillot', 'Zalmhaasje'],
  },
  {
    title: 'Hamburgers',
    items: ['Rundshamburger', 'Entrecote burger', 'Kippenburger', 'Spekburger'],
  },
  {
    title: 'BBQ Worsten',
    items: ['Barbecueworstje', 'Boerenworst', 'Kippenworst', 'Chipolatta', 'Merguez worst', 'Worst saté', 'BBQ witte pens met kaas'],
  },
  {
    title: 'Satés & Brochettes',
    items: ['Gemengde saté natuur', 'Gemarineerde kalkoensaté', 'Gemarineerde rundsbrochette', 'Gemarineerde varkensbrochette', 'Gekruide varkenssaté'],
  },
];
---

<Layout
  title="BBQ Assortiment | Slagerij Herremans Wemmel"
  description="Slagerij Herremans is uw BBQ specialist in Wemmel! Ontdek ons assortiment: gemarineerd vlees, brochettes, satés, hamburgers, BBQ worsten en meer. Bestel online."
  currentPage="bbq"
>
  <Hero
    title="BBQ Assortiment"
    subtitle="Culinaire slagerij Herremans is uw barbecuespecialist!"
    image="/images/bbq/bbq_1.jpg"
    compact
  />

  <!-- BBQ images -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-1">
        <div class="overflow-hidden reveal">
          <img src="/images/bbq/bbq_1.jpg" alt="BBQ selectie" class="w-full h-72 object-cover hover:scale-105 transition-transform duration-700" loading="lazy" />
        </div>
        <div class="overflow-hidden reveal">
          <img src="/images/bbq/bbq_2.jpg" alt="BBQ bereiding" class="w-full h-72 object-cover hover:scale-105 transition-transform duration-700" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- BBQ Categories -->
  <section class="py-20 lg:py-28 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map(cat => (
          <div class="reveal group bg-white p-6 border border-gray-100 hover:border-brand-red/30 hover:shadow-xl transition-all duration-300 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-0.5 bg-brand-red scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
            <h2 class="text-lg font-bold text-gray-900 mb-4 pb-3 border-b border-gray-100 tracking-tight uppercase">
              {cat.title}
            </h2>
            <ul class="space-y-2">
              {cat.items.map(item => (
                <li class="text-gray-600 flex items-start gap-2.5 text-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-red mt-1.5 flex-shrink-0"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 overflow-hidden">
    <img src="/images/bbq/bbq_2.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-4 text-center reveal">
      <h2 class="text-4xl font-bold text-white mb-6">Klaar voor uw BBQ?</h2>
      <p class="text-gray-300 text-lg mb-8">Bestel uw BBQ pakket online of kom langs in onze winkel in Wemmel.</p>
      <a
        href="https://webshop.slagerijherremans.be"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 bg-brand-red text-white font-semibold tracking-wide uppercase hover:bg-brand-red-dark transition-all duration-300 hover:scale-105"
      >
        Bestel Online
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </section>
</Layout>

<style is:global>
  .reveal { opacity: 0; transform: translateY(40px); transition: opacity 0.8s ease, transform 0.8s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
</style>
<script>
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
  reveals.forEach(el => observer.observe(el));
</script>
