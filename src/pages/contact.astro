---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Map from '../components/Map.astro';

const openingHours = [
  { day: 'Maandag', hours: '08:00 - 19:00' },
  { day: 'Dinsdag', hours: '08:00 - 19:00' },
  { day: 'Woensdag', hours: '08:00 - 19:00' },
  { day: 'Donderdag', hours: '08:00 - 19:00' },
  { day: 'Vrijdag', hours: '08:00 - 19:00' },
  { day: 'Zaterdag', hours: '08:30 - 17:00' },
  { day: 'Zondag', hours: 'Gesloten' },
];
---

<Layout
  title="Contact & Openingsuren | Slagerij Herremans Wemmel"
  description="Slagerij Herremans: Cdt. J. De Blockplein 17, 1780 Wemmel. Tel: 02 460 48 76. Open ma-vr 08:00-19:00, za 08:30-17:00. Routebeschrijving en contactgegevens."
  currentPage="contact"
>
  <Hero
    title="Contact"
    subtitle="Wij verwelkomen u graag in onze winkel"
    image="/images/album/album-3.jpg"
    compact
  />

  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Contact Info -->
        <div class="reveal">
          <span class="text-brand-red font-semibold tracking-widest uppercase text-sm">Contactgegevens</span>
          <h2 class="text-4xl font-bold text-gray-900 mt-3 mb-10">Neem contact op</h2>

          <div class="space-y-8">
            <div class="flex items-start gap-5">
              <div class="flex-shrink-0 w-12 h-12 bg-black flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-gray-900 uppercase tracking-wide text-sm mb-1">Adres</p>
                <p class="text-gray-600">Cdt. J. De Blockplein 17</p>
                <p class="text-gray-600">1780 Wemmel</p>
              </div>
            </div>

            <div class="flex items-start gap-5">
              <div class="flex-shrink-0 w-12 h-12 bg-black flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-gray-900 uppercase tracking-wide text-sm mb-1">Telefoon</p>
                <a href="tel:024604876" class="text-gray-600 hover:text-brand-red transition-colors">02 460 48 76</a>
              </div>
            </div>

            <div class="flex items-start gap-5">
              <div class="flex-shrink-0 w-12 h-12 bg-black flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-gray-900 uppercase tracking-wide text-sm mb-1">E-mail</p>
                <a href="mailto:herremans.wemmel@gmail.com" class="text-gray-600 hover:text-brand-red transition-colors">herremans.wemmel@gmail.com</a>
              </div>
            </div>

            <div class="flex items-start gap-5">
              <div class="flex-shrink-0 w-12 h-12 bg-black flex items-center justify-center">
                <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-gray-900 uppercase tracking-wide text-sm mb-1">BTW nummer</p>
                <p class="text-gray-600">BE0735494877</p>
              </div>
            </div>
          </div>

          <!-- Opening Hours -->
          <div class="mt-12 reveal">
            <span class="text-brand-red font-semibold tracking-widest uppercase text-sm">Openingsuren</span>
            <h2 class="text-2xl font-bold text-gray-900 mt-3 mb-6">Wanneer zijn wij open</h2>
            <dl class="space-y-0">
              {openingHours.map(({ day, hours }) => (
                <div class="flex justify-between py-3 border-b border-gray-100">
                  <dt class="text-gray-600">{day}</dt>
                  <dd class:list={[
                    'font-semibold',
                    hours === 'Gesloten' ? 'text-brand-red' : 'text-gray-900'
                  ]}>{hours}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>

        <!-- Map -->
        <div class="reveal">
          <span class="text-brand-red font-semibold tracking-widest uppercase text-sm">Locatie</span>
          <h2 class="text-4xl font-bold text-gray-900 mt-3 mb-10">Waar vindt u ons</h2>
          <Map />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .reveal { opacity: 0; transform: translateY(40px); transition: opacity 0.8s ease, transform 0.8s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
</style>
<script>
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
  reveals.forEach(el => observer.observe(el));
</script>
