---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import Gallery from '../components/Gallery.astro';
import Map from '../components/Map.astro';

const galleryAlts = [
  'Vers vlees vitrine in de slagerij',
  'Ambachtelijk bereide charcuterie',
  'Selectie kazen op de toonbank',
  'Vers belegde broodjes',
  'Dry aged vlees in de rijpkast',
  'Huisbereide gehaktbereidingen',
  'Seizoensgebonden vleesschotels',
  'Gevulde kalfsrollade',
  'BBQ vlees selectie',
  'Verse rundsbiefstuk',
  'Bereide gerechten voor het weekend',
  'Ambachtelijke paté en terrines',
  'Feestelijke vleesschotel',
  'Gemarineerde brochettes',
  'Verse varkensvlees bereidingen',
  'Presentatie van ons assortiment',
];

const galleryImages = Array.from({ length: 16 }, (_, i) => ({
  src: `/images/album/album-${i + 1}.jpg`,
  alt: galleryAlts[i],
}));

const products = [
  { title: 'Vers Vlees', image: '/images/cow.png' },
  { title: 'Bereide Gerechten', image: '/images/plate.png' },
  { title: 'Kazen', image: '/images/cheese.png' },
  { title: 'Broodjes', image: '/images/bread.png' },
  { title: 'Dry Aged', image: '/images/dry_aged.png' },
  { title: 'Huisbereide Charcuterie', image: '/images/homemade.png' },
];
---

<Layout
  title="Slagerij Herremans Wemmel | Ambachtelijke slagerij sinds 1920"
  description="Slagerij Herremans in Wemmel: al 4 generaties ambachtelijk vers vlees, bereide gerechten, kazen, broodjes, dry aged en huisbereide charcuterie. Bestel online of bezoek onze winkel."
  currentPage="home"
>
  <!-- Hero -->
  <Hero
    title="Ambachtelijk sinds 1920"
    subtitle="Culinaire slagerij Herremans — Al vier generaties vakmanschap in Wemmel"
    image="/images/background-image.jpg"
    ctaText="Bestel Online"
    ctaLink="https://webshop.slagerijherremans.be"
  />

  <!-- Intro Section -->
  <section class="py-20 lg:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <span class="text-brand-red font-semibold tracking-widest uppercase text-sm">Over ons</span>
          <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mt-3 mb-8 leading-tight">
            Culinaire slagerij<br />met <span class="text-brand-red">passie</span>
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            Authenticiteit en kwaliteit zijn 2 belangrijke pijlers die wij vooropstellen in onze slagerij.
            Naast een uitgebreid assortiment van kwaliteitsvol vlees, bieden wij ook heel wat verse
            zelfbereide producten aan.
          </p>
          <p class="text-lg text-gray-600 leading-relaxed mb-10">
            Kiezen voor vlees van bij Herremans, is kiezen voor de korte keten tussen Boer en Slager.
            <strong class="text-gray-900">Proef het verschil!</strong>
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/assortiment" class="inline-flex items-center gap-2 px-7 py-3.5 bg-brand-red text-white font-semibold tracking-wide uppercase hover:bg-brand-red-dark transition-all duration-300 hover:gap-3">
              Ontdek ons aanbod
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            <a href="/broodjesfolder.pdf" target="_blank" class="inline-flex items-center px-7 py-3.5 border-2 border-black text-black font-semibold tracking-wide uppercase hover:bg-black hover:text-white transition-all duration-300">
              Broodjesfolder
            </a>
          </div>
        </div>
        <div class="reveal relative">
          <div class="absolute -inset-4 bg-brand-red/10 -rotate-3 rounded-lg"></div>
          <div class="relative aspect-video rounded-lg shadow-2xl overflow-hidden bg-black">
            <video
              class="absolute inset-0 w-full h-full object-cover"
              controls
              preload="none"
              poster="/images/album/album-1.jpg"
            >
              <source src="/videos/promo.mp4" type="video/mp4" />
              Uw browser ondersteunt geen HTML5 video.
            </video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Categories — Dark section -->
  <section class="py-20 lg:py-28 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16 reveal">
        <span class="text-brand-red font-semibold tracking-widest uppercase text-sm">Assortiment</span>
        <h2 class="text-4xl lg:text-5xl font-bold text-white mt-3">Ons Aanbod</h2>
        <div class="w-16 h-0.5 bg-brand-red mx-auto mt-6"></div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-1">
        {products.map(product => (
          <ProductCard title={product.title} image={product.image} />
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery — Edge to edge -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12 reveal">
      <div class="text-center">
        <span class="text-brand-red font-semibold tracking-widest uppercase text-sm">Fotogalerij</span>
        <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mt-3">Ambachtelijke kwaliteit</h2>
        <div class="w-16 h-0.5 bg-brand-red mx-auto mt-6"></div>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Gallery images={galleryImages} />
    </div>
    <div class="text-center mt-12 reveal">
      <div class="inline-flex items-center gap-4">
        <img src="/images/generaties.jpg" alt="4 generaties Herremans" class="w-14 h-14 rounded-full object-cover ring-2 ring-brand-red ring-offset-2" loading="lazy" />
        <div class="text-left">
          <span class="block text-lg font-bold text-gray-900">Al 4 generaties lang</span>
          <span class="text-sm text-gray-500">Sinds 1920 in Wemmel</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews — Dark section -->
  <section class="py-20 lg:py-28 bg-black relative overflow-hidden">
    <!-- Subtle background pattern -->
    <div class="absolute inset-0 opacity-5" style="background-image: url('data:image/svg+xml,<svg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;><g fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;><g fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot;><path d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/></g></g></svg>');"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="text-center mb-16 reveal">
        <span class="text-brand-red font-semibold tracking-widest uppercase text-sm">Recensies</span>
        <h2 class="text-4xl lg:text-5xl font-bold text-white mt-3">Wat onze klanten zeggen</h2>
        <div class="w-16 h-0.5 bg-brand-red mx-auto mt-6"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <blockquote class="reveal bg-white/5 backdrop-blur-sm border border-white/10 p-8 relative">
          <span class="absolute -top-4 left-6 text-6xl text-brand-red font-serif leading-none">&ldquo;</span>
          <div class="flex gap-1 text-brand-red mb-4 mt-4">
            {Array(5).fill(0).map(() => <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>)}
          </div>
          <p class="text-gray-300 text-lg leading-relaxed mb-4">
            Beste slagerij in de wijde omtrek! Altijd vers, vriendelijke bediening en een geweldige keuze aan producten. Aanrader!
          </p>
          <cite class="text-sm text-gray-500 not-italic tracking-wide uppercase">— via Facebook</cite>
        </blockquote>
        <blockquote class="reveal bg-white/5 backdrop-blur-sm border border-white/10 p-8 relative">
          <span class="absolute -top-4 left-6 text-6xl text-brand-red font-serif leading-none">&ldquo;</span>
          <div class="flex gap-1 text-brand-red mb-4 mt-4">
            {Array(5).fill(0).map(() => <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>)}
          </div>
          <p class="text-gray-300 text-lg leading-relaxed mb-4">
            Top slagerij! Heerlijk vers vlees en de bereide gerechten zijn om van te smullen. Zeer tevreden klant sinds jaren.
          </p>
          <cite class="text-sm text-gray-500 not-italic tracking-wide uppercase">— via Facebook</cite>
        </blockquote>
      </div>
      <div class="text-center mt-10 reveal">
        <a
          href="https://www.facebook.com/SlagerijHerremans/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-brand-red font-medium tracking-wide hover:gap-3 transition-all duration-300"
        >
          Bekijk alle reviews op Facebook
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA — Full-width image background -->
  <section class="relative py-24 lg:py-32 overflow-hidden">
    <img src="/images/album/album-7.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-4 text-center reveal">
      <h2 class="text-4xl lg:text-5xl font-bold text-white mb-6">Bestel online</h2>
      <p class="text-xl text-gray-300 mb-10 font-light">
        Bestel gemakkelijk via onze webshop en haal uw bestelling op in de winkel.
      </p>
      <a
        href="https://webshop.slagerijherremans.be"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-10 py-4 bg-brand-red text-white text-lg font-semibold tracking-wide uppercase hover:bg-brand-red-dark transition-all duration-300 hover:scale-105 hover:gap-4"
      >
        Bestel online / Commandez en ligne
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </section>

  <!-- Map -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <span class="text-brand-red font-semibold tracking-widest uppercase text-sm">Locatie</span>
        <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mt-3">Waar vindt u ons</h2>
        <p class="mt-4 text-lg text-gray-600">Cdt. J. De Blockplein 17, 1780 Wemmel</p>
        <div class="w-16 h-0.5 bg-brand-red mx-auto mt-6"></div>
      </div>
      <Map />
    </div>
  </section>
</Layout>

<!-- Scroll reveal animation -->
<style is:global>
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  reveals.forEach(el => observer.observe(el));
</script>
