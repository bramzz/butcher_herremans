---
interface Props {
  title: string;
  image: string;
  href?: string;
}

const { title, image, href = '/assortiment' } = Astro.props;
---

<a href={href} class="group relative block bg-black overflow-hidden reveal">
  <div class="aspect-square overflow-hidden flex items-center justify-center p-8">
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="w-3/4 h-3/4 object-contain transition-all duration-500 group-hover:scale-110 brightness-0 invert opacity-70 group-hover:opacity-100"
    />
  </div>
  <!-- Red bottom accent -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-brand-red scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
  <div class="p-4 text-center border-t border-white/10">
    <h3 class="text-sm font-semibold tracking-widest uppercase text-white/80 group-hover:text-brand-red transition-colors duration-300">
      {title}
    </h3>
  </div>
</a>
