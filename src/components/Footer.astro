---
const openingHours = [
  { day: 'Maandag', hours: '08:00 - 19:00' },
  { day: 'Dinsdag', hours: '08:00 - 19:00' },
  { day: 'Woensdag', hours: '08:00 - 19:00' },
  { day: 'Donderdag', hours: '08:00 - 19:00' },
  { day: 'Vrijdag', hours: '08:00 - 19:00' },
  { day: 'Zaterdag', hours: '08:30 - 17:00' },
  { day: 'Zondag', hours: 'Gesloten' },
];
---

<footer class="bg-black text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-16">
      <!-- Opening Hours -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Openingsuren</h3>
        <dl class="space-y-2">
          {openingHours.map(({ day, hours }) => (
            <div class="flex justify-between text-sm">
              <dt class="text-gray-300">{day}</dt>
              <dd class:list={[
                hours === 'Gesloten' ? 'text-brand-red font-medium' : 'text-white'
              ]}>{hours}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Contact</h3>
        <address class="not-italic space-y-3 text-sm text-gray-300">
          <p>
            Cdt. J. De Blockplein 17<br />
            1780 Wemmel
          </p>
          <p>
            <a href="tel:024604876" class="hover:text-brand-red transition-colors">
              02 460 48 76
            </a>
          </p>
          <p>
            <a href="mailto:herremans.wemmel@gmail.com" class="hover:text-brand-red transition-colors">
              herremans.wemmel@gmail.com
            </a>
          </p>
        </address>
      </div>

      <!-- Social & Links -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Volg ons</h3>
        <div class="flex gap-4 mb-6">
          <a
            href="https://www.facebook.com/SlagerijHerremans/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-brand-red transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a
            href="https://www.instagram.com/slagerijherremans/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-brand-red transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a
            href="mailto:herremans.wemmel@gmail.com"
            class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-brand-red transition-colors"
            aria-label="E-mail"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </a>
        </div>
        <div class="space-y-2 text-sm">
          <a href="/kerstfolder.pdf" target="_blank" class="block text-gray-300 hover:text-brand-red transition-colors">
            Kerstfolder (PDF)
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 text-center text-sm text-gray-500">
      &copy; {new Date().getFullYear()} Slagerij Herremans &mdash; Ambachtelijk sinds 1920
    </div>
  </div>
</footer>
